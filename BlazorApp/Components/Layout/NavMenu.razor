
@using BlazorApp.Auth
@inject SimpleAuthProvider AuthProvider
@inject NavigationManager Navigation

@* Gornji deo navigacionog menija. *@
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Forum App</a>
    </div>
</div>

@* Dugme za otvaranje i zatvaranje menija. *@
<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

@* Glavni navigacioni meni. *@
<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        @* Pocetna stranica. *@
        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                Home
            </NavLink>
        </div>

        @* Stranica za korisnike. *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="users">
                Users
            </NavLink>
        </div>

        @* Pregled svih objava. *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="posts">
                Posts
            </NavLink>
        </div>

        @* Kreiranje objave samo za prijavljene korisnike. *@
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="create-post">
                        Create Post
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Prikazujemo Login ili Logout prema stanju korisnika. *@
        <AuthorizeView>
            <Authorized Context="loggedInUser">
                <div class="nav-item px-3">
                    <span class="nav-link">
                        Hello, @loggedInUser.User.Identity?.Name
                    </span>
                </div>

                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link"
                            @onclick="Logout">
                        Logout
                    </button>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    // Odjavljujemo korisnika iz aplikacije.
    private void Logout()
    {
        AuthProvider.Logout();

        // Vracamo korisnika na pocetnu stranicu.
        Navigation.NavigateTo("/");
    }
}
