
@page "/posts/{Id:int}"

@using System.Security.Claims
@using ApiContracts
@using BlazorApp.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IPostService PostService
@inject IUserService UserService
@inject ICommentService CommentService
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Post Details</PageTitle>

@if (loading)
{
    <p>Loading post...</p>
}
else if (post == null)
{
    <p class="text-danger">@errorMessage</p>
}
else
{
    @* Naslov i sadrzaj objave. *@
    <h3>@post.Title</h3>

    <p>
        <strong>Author:</strong> @authorName
    </p>

    <p style="white-space: pre-wrap;">@post.Body</p>

    <hr />

    <h4>Comments</h4>

    @* Prikazujemo komentare za ovu objavu. *@
    @if (comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        @foreach (CommentDto comment in comments)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <p>@comment.Body</p>

                    <small class="text-muted">
                        User ID: @comment.UserId
                    </small>
                </div>
            </div>
        }
    }

    <hr />

    <AuthorizeView>
        <Authorized>
            @* Samo prijavljeni korisnici mogu dodati komentar. *@
            <h4>Add Comment</h4>

            <div class="mb-3">
                <textarea class="form-control"
                          rows="4"
                          @bind="newComment"></textarea>
            </div>

            <button class="btn btn-primary"
                    @onclick="AddComment"
                    disabled="@saving">
                Add Comment
            </button>
        </Authorized>

        <NotAuthorized>
            <p>
                Please <a href="/login">log in</a> to add a comment.
            </p>
        </NotAuthorized>
    </AuthorizeView>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger mt-3">@errorMessage</p>
    }
}

<div class="mt-3">
    <a href="/posts">Back to Posts</a>
</div>

@code {
    // ID objave preuzimamo iz URL adrese.
    [Parameter]
    public int Id { get; set; }

    // Podaci o objavi i njenom autoru.
    private PostDto? post;
    private string authorName = "";

    // Lista komentara.
    private List<CommentDto> comments = new();

    // Tekst novog komentara.
    private string newComment = "";

    // Stanje stranice.
    private bool loading = true;
    private bool saving = false;
    private string errorMessage = "";

    // Ucitavamo objavu kada se promeni ID u URL adresi.
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        errorMessage = "";
        post = null;
        comments = new();

        try
        {
            // Preuzimamo objavu.
            post = await PostService.GetPostAsync(Id);

            // Pokusavamo da pronadjemo ime autora.
            try
            {
                UserDto author =
                    await UserService.GetUserAsync(post.UserId);

                authorName = author.UserName;
            }
            catch
            {
                authorName = $"User {post.UserId}";
            }

            // Ucitavamo komentare ove objave.
            comments = await CommentService.GetCommentsAsync(Id);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    // Dodajemo novi komentar.
    private async Task AddComment()
    {
        // Proveravamo da li je korisnik uneo tekst.
        if (string.IsNullOrWhiteSpace(newComment))
        {
            errorMessage = "Please enter a comment.";
            return;
        }

        saving = true;
        errorMessage = "";

        try
        {
            // Preuzimamo informacije o prijavljenom korisniku.
            AuthenticationState authState =
                await AuthProvider.GetAuthenticationStateAsync();

            // Pronalazimo njegov ID u claims.
            string? userIdText = authState.User
                .FindFirst(ClaimTypes.NameIdentifier)?.Value;

            // Ne dozvoljavamo komentar bez prijave.
            if (!int.TryParse(userIdText, out int userId))
            {
                errorMessage = "Please log in to comment.";
                return;
            }

            // Kreiramo komentar sa pravim ID-jem korisnika.
            CreateCommentDto request = new()
            {
                Body = newComment,
                UserId = userId,
                PostId = Id
            };

            // Saljemo komentar Web API-ju.
            await CommentService.AddCommentAsync(request);

            // Praznimo polje i ponovo ucitavamo komentare.
            newComment = "";
            comments = await CommentService.GetCommentsAsync(Id);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
