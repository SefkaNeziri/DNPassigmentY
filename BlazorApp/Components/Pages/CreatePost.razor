
@page "/create-post"
@attribute [Authorize]

@using System.Security.Claims
@using ApiContracts
@using BlazorApp.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject IPostService PostService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Create Post</PageTitle>

<h3>Create New Post</h3>

@* Polje za naslov nove objave. *@
<div class="mb-3">
    <label>Title</label>
    <input class="form-control" @bind="title" />
</div>

@* Polje za tekst objave. *@
<div class="mb-3">
    <label>Body</label>
    <textarea class="form-control"
              rows="6"
              @bind="body"></textarea>
</div>

@* Dugme za kreiranje objave. *@
<button class="btn btn-primary"
        @onclick="SubmitPost"
        disabled="@saving">
    Create Post
</button>

<a class="btn btn-secondary ms-2" href="/posts">
    Cancel
</a>

@* Poruka u slucaju greske. *@
@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger mt-3">@errorMessage</p>
}

@code {
    // Podaci koje korisnik unosi.
    private string title = "";
    private string body = "";

    // Pratimo cuvanje i eventualne greske.
    private bool saving = false;
    private string errorMessage = "";

    // Metoda za kreiranje nove objave.
    private async Task SubmitPost()
    {
        // Proveravamo da li su oba polja popunjena.
        if (string.IsNullOrWhiteSpace(title) ||
            string.IsNullOrWhiteSpace(body))
        {
            errorMessage = "Please enter title and body.";
            return;
        }

        saving = true;
        errorMessage = "";

        try
        {
            // Preuzimamo podatke o prijavljenom korisniku.
            AuthenticationState authState =
                await AuthProvider.GetAuthenticationStateAsync();

            // Pronalazimo ID korisnika u njegovim claims.
            string? userIdText = authState.User
                .FindFirst(ClaimTypes.NameIdentifier)?.Value;

            // Ako korisnik nije prijavljen, ne kreiramo objavu.
            if (!int.TryParse(userIdText, out int userId))
            {
                errorMessage = "Please log in first.";
                return;
            }

            // Kreiramo zahtev sa ID-jem prijavljenog korisnika.
            CreatePostDto request = new()
            {
                Title = title,
                Body = body,
                UserId = userId
            };

            // Saljemo objavu Web API-ju.
            PostDto createdPost =
                await PostService.AddPostAsync(request);

            // Otvaramo detalje nove objave.
            Navigation.NavigateTo($"/posts/{createdPost.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
